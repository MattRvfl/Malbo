<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Malbo</AssemblyName>
    <ApplicationIcon>Assets\malbo.ico</ApplicationIcon>
    <Product>Malbo</Product>
    <Version>1.3.0-alpha</Version>
    <RootNamespace>DynamicIsland</RootNamespace>
    <NoWarn>CA1416;CS4014;CS1998</NoWarn>
    <!-- Mémoire : GC poste de travail sans thread de fond, rend la RAM au système, ressources en français uniquement. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 0-9 : plus la valeur est haute, plus le GC compacte pour garder le tas petit. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\malbo.png" />
    <Resource Include="Assets\malbo.ico" />
  </ItemGroup>
</Project>
