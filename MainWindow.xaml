<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Malbo" Icon="Assets/malbo.ico" Width="720" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Menus contextuels sombres (île, playlists) -->
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F21C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="8,6" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="chk" FontFamily="{StaticResource Icons}" Text="&#xE73E;" FontSize="11" VerticalAlignment="Center" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSep" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#26FFFFFF" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" VerticalAlignment="Top" HorizontalAlignment="Center">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ScaleT" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

        <!-- Zone de survol élargie autour de l'île (padding réglé par S.HoverZone) -->
        <Border x:Name="HitZone" Background="#01000000" Padding="12,8,12,12" VerticalAlignment="Top">

        <Border x:Name="Island" Width="190" Height="36" CornerRadius="18"
                Background="{DynamicResource IslandBg}" VerticalAlignment="Top" HorizontalAlignment="Center"
                AllowDrop="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>

            <Grid x:Name="Inner">

                <!-- Fond flouté (pochette) -->
                <Image x:Name="ArtBackdrop" Stretch="UniformToFill" Margin="-40" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Image.Effect>
                        <BlurEffect Radius="70" RenderingBias="Performance"/>
                    </Image.Effect>
                </Image>

                <!-- ============ COMPACT ============ -->
                <Grid x:Name="CompactLayer" Margin="7,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="CompactArt" Width="24" Height="24" CornerRadius="7" Visibility="Collapsed"/>
                        <TextBlock x:Name="CompactIcon" FontFamily="{StaticResource Icons}" Text="&#xE823;" FontSize="13"
                                   Foreground="{DynamicResource SubFg}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="CompactText" Grid.Column="1" Foreground="{DynamicResource Fg}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactRight" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FFFF9F0A" Margin="2,0" Visibility="Collapsed"/>
                        <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#FF30D158" Margin="2,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="Bars" Orientation="Horizontal" Height="18" Margin="4,0,0,0" Visibility="Collapsed">
                            <Rectangle x:Name="Bar0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Margin="1,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ PEEK (notifs, OSD, alertes) ============ -->
                <Grid x:Name="PeekLayer" Margin="14,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PeekIconBox" Width="44" Height="44" VerticalAlignment="Center">
                        <Border x:Name="PeekImg" CornerRadius="11" Visibility="Collapsed"/>
                        <TextBlock x:Name="PeekGlyph" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock x:Name="PeekTitle" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekBody" Foreground="{DynamicResource SubFg}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34"/>
                        <ProgressBar x:Name="PeekProgress" Style="{StaticResource Thin}" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="PeekActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>

                <!-- ============ EXPANDED ============ -->
                <DockPanel x:Name="ExpandedLayer" Width="656" Height="406" Margin="12,12,12,12"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabMedia" Style="{StaticResource TabBtn}" Content="&#xE8D6;" Tag="Média" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabNotif" Style="{StaticResource TabBtn}" Content="&#xEA8F;" Tag="Notifs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabTools" Style="{StaticResource TabBtn}" Content="&#xE916;" Tag="Outils" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabFiles" Style="{StaticResource TabBtn}" Content="&#xE8B7;" Tag="Fichiers" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabSystem" Style="{StaticResource TabBtn}" Content="&#xE7F4;" Tag="Système" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabInfo" Style="{StaticResource TabBtn}" Content="&#xE753;" Tag="Infos" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabLaunch" Style="{StaticResource TabBtn}" Content="&#xE71D;" Tag="Lancer" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabMore" Style="{StaticResource TabBtn}" Content="&#xE712;" Tag="Plus" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabPlugins" Style="{StaticResource TabBtn}" Content="&#xEA86;" Tag="Plugins" Checked="Tab_Checked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Image Source="Assets/malbo.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Malbo" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="HeaderClock" Foreground="{DynamicResource SubFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Content="&#xE718;" ToolTip="Épingler ouvert (Ctrl+Alt+I)" Click="Pin_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Réglages" Click="Settings_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="Panels">

                        <!-- ===== MÉDIA ===== -->
                        <Grid x:Name="PanelMedia">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BigArt" Width="92" Height="92" CornerRadius="14" Background="{DynamicResource CardBg}">
                                        <TextBlock x:Name="BigArtGlyph" FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="30"
                                                   Foreground="{DynamicResource SubFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MediaTitle" Text="Rien en lecture" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MediaArtist" FontSize="12.5" Foreground="{DynamicResource SubFg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="MediaApp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <Button x:Name="LikeBtn" Style="{StaticResource IconBtn}" Content="&#xEB51;" FontSize="12" Width="24" Height="24" Margin="4,0,0,0"
                                                    ToolTip="J'aime" Visibility="Collapsed" Click="Like_Click"/>
                                            <Button x:Name="PlaylistBtn" Style="{StaticResource IconBtn}" Content="&#xECC8;" FontSize="12" Width="24" Height="24"
                                                    ToolTip="Ajouter à une playlist" Visibility="Collapsed" Click="Playlist_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="MediaSlider" DockPanel.Dock="Top" Margin="0,12,0,0" IsMoveToPointEnabled="True" Minimum="0" Maximum="1"/>
                                <Grid DockPanel.Dock="Top">
                                    <TextBlock x:Name="MediaPos" Text="0:00" Style="{StaticResource Sub}"/>
                                    <TextBlock x:Name="MediaDur" Text="0:00" Style="{StaticResource Sub}" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Button x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" Content="&#xE8B1;" Click="Shuffle_Click" Width="34" Height="34" FontSize="14"
                                            Opacity="0.45" ToolTip="Lecture aléatoire" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click" Width="40" Height="40" FontSize="17" VerticalAlignment="Center"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" Click="Play_Click" Width="48" Height="48" FontSize="22" Margin="8,0"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click" Width="40" Height="40" FontSize="17" VerticalAlignment="Center"/>
                                    <Button x:Name="RepeatBtn" Style="{StaticResource IconBtn}" Content="&#xE8EE;" Click="Repeat_Click" Width="34" Height="34" FontSize="14"
                                            Opacity="0.45" ToolTip="Répéter" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Top" Text="VOLUME PAR APPLICATION" Style="{StaticResource Sub}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AppVolList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,6,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
                                                    <Slider Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" IsMoveToPointEnabled="True"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Background="#22808080" Margin="0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="Paroles" Style="{StaticResource H}"/>
                                        <TextBlock x:Name="LyricsStatus" Style="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid x:Name="LyricsViewport" ClipToBounds="True" Background="Transparent">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#FF000000" Offset="0.14"/>
                                                <GradientStop Color="#FF000000" Offset="0.82"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <!-- marge basse négative : le panneau n'est jamais rogné par la mise en page quand il est décalé -->
                                        <StackPanel x:Name="LyricsPanel" VerticalAlignment="Top" Margin="0,0,4,-20000">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform x:Name="LyricsShift"/>
                                            </StackPanel.RenderTransform>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ===== NOTIFICATIONS ===== -->
                        <DockPanel x:Name="PanelNotif" Visibility="Collapsed">
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,6">
                                <TextBlock Text="Notifications" Style="{StaticResource H}" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox x:Name="DndCheck" Content="Ne pas déranger" VerticalAlignment="Center" Margin="0,0,8,0" Click="Dnd_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Tout effacer" Click="NotifClear_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NotifStatus" DockPanel.Dock="Top" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="4,0,4,6"/>
                            <Border x:Name="VoiceCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="13" Foreground="#FF30D158" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="VoiceChannel" Style="{StaticResource H}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl x:Name="VoiceList" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="34" Height="34" Margin="0,0,6,2" ToolTip="{Binding Name}">
                                                        <Ellipse Fill="{DynamicResource CardHover}"/>
                                                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Fg}" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse Margin="1">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <Ellipse x:Name="ring" Stroke="#FF30D158" StrokeThickness="2.5" Visibility="Hidden"/>
                                                        <Border Width="15" Height="15" CornerRadius="7.5" Background="#FFFF453A" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,-2,-2" Visibility="{Binding MutedVis}">
                                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xF781;" FontSize="8" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Speaking}" Value="True">
                                                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button x:Name="VoiceMuteBtn" Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE720;" VerticalAlignment="Top"
                                            ToolTip="Couper / rétablir mon micro" Click="VoiceMute_Click"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <TextBlock x:Name="NotifEmpty" Text="Aucune notification pour l'instant.&#x0a;Discord, Telegram, WhatsApp, Messenger, Slack, Teams, mails… apparaîtront ici."
                                           Style="{StaticResource Sub}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="NotifList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="10" Margin="4,3" Cursor="Hand" Tag="{Binding}"
                                                        MouseLeftButtonDown="NotifCard_Down" MouseMove="NotifCard_Move" MouseLeftButtonUp="NotifCard_Up">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="30" Height="30" VerticalAlignment="Top"/>
                                                        <StackPanel Grid.Column="1" Margin="8,0">
                                                            <TextBlock Text="{Binding Header}" Style="{StaticResource Sub}"/>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Body}" Foreground="{DynamicResource Fg}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE823;" FontSize="11" Width="26" Height="26" Tag="{Binding}" ToolTip="Me le rappeler plus tard" Click="NotifSnooze_Click"/>
                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="11" Width="26" Height="26" Tag="{Binding}" Click="NotifDismiss_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>

                        <!-- ===== OUTILS ===== -->
                        <Grid x:Name="PanelTools" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <RadioButton x:Name="TmTimer" Style="{StaticResource SegBtn}" GroupName="tm" Content="Minuteur" IsChecked="True" Checked="TimerMode_Checked"/>
                                        <RadioButton x:Name="TmChrono" Style="{StaticResource SegBtn}" GroupName="tm" Content="Chrono" Checked="TimerMode_Checked"/>
                                        <RadioButton x:Name="TmPomo" Style="{StaticResource SegBtn}" GroupName="tm" Content="Pomodoro" Checked="TimerMode_Checked"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerDisplay" DockPanel.Dock="Top" Text="05:00" FontSize="44" FontWeight="Light"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="TimerSub" DockPanel.Dock="Top" Text="Minuteur" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="TimerProgress" DockPanel.Dock="Top" Style="{StaticResource Thin}" Maximum="1" Margin="8,12"/>
                                    <WrapPanel x:Name="TimerPresets" DockPanel.Dock="Top" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource PillBtn}" Content="1 min" Tag="1" Click="Preset_Click"/>
                                        <Button Style="{StaticResource PillBtn}" Content="5 min" Tag="5" Click="Preset_Click"/>
                                        <Button Style="{StaticResource PillBtn}" Content="10 min" Tag="10" Click="Preset_Click"/>
                                        <Button Style="{StaticResource PillBtn}" Content="15 min" Tag="15" Click="Preset_Click"/>
                                        <Button Style="{StaticResource PillBtn}" Content="30 min" Tag="30" Click="Preset_Click"/>
                                        <TextBox x:Name="TimerCustom" Style="{StaticResource Input}" Width="56" Margin="2" ToolTip="Minutes perso + Entrée" KeyDown="TimerCustom_KeyDown"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                        <Button x:Name="TimerStartBtn" Style="{StaticResource PillBtn}" Content="Démarrer" Padding="20,7" Click="TimerStart_Click"/>
                                        <Button Style="{StaticResource PillBtn}" Content="Réinitialiser" Padding="14,7" Click="TimerReset_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Alarmes &amp; rappels" Style="{StaticResource H}"/>
                                    <Grid DockPanel.Dock="Top" Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AlarmTime" Style="{StaticResource Input}" Text="07:30" ToolTip="HH:mm"/>
                                        <TextBox x:Name="AlarmLabel" Grid.Column="1" Style="{StaticResource Input}" Margin="4,0" Text="Rappel"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE710;" Width="28" Height="28" Click="AddAlarm_Click"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="AlarmList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Fg}" FontSize="18" FontWeight="Light"/>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" FontSize="12" Width="26" Height="26" Tag="{Binding}" Click="AlarmDelete_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="À faire" Style="{StaticResource H}"/>
                                    <TextBox x:Name="TodoInput" DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,8" ToolTip="Nouvelle tâche + Entrée" KeyDown="TodoInput_KeyDown"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="TodoList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Click="Todo_Changed" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                                                        </CheckBox>
                                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="10" Width="22" Height="22" Tag="{Binding}" Click="TodoDelete_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ===== FICHIERS ===== -->
                        <Grid x:Name="PanelFiles" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top">
                                        <TextBlock Text="Étagère" Style="{StaticResource H}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource PillBtn}" Content="Vider" HorizontalAlignment="Right" Click="ShelfClear_Click"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="Glisse des fichiers sur l'île pour les garder ici, puis fais-les glisser où tu veux."
                                               Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ShelfList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardHover}" CornerRadius="10" Padding="6" Margin="0,2" Cursor="Hand"
                                                            Tag="{Binding}" MouseMove="ShelfItem_MouseMove">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Fg}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE8A7;" FontSize="11" Width="24" Height="24" ToolTip="Ouvrir" Tag="{Binding}" Click="ShelfOpen_Click"/>
                                                            <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="10" Width="24" Height="24" ToolTip="Retirer" Tag="{Binding}" Click="ShelfRemove_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top">
                                        <TextBlock Text="Presse-papiers" Style="{StaticResource H}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource PillBtn}" Content="Effacer" HorizontalAlignment="Right" Click="ClipClear_Click"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="Clic : recopier · clic droit : épingler, lire le texte d'une image, supprimer." Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                    <TextBox x:Name="ClipSearch" DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,6" ToolTip="Rechercher dans l'historique" TextChanged="ClipSearch_Changed"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ClipList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardHover}" CornerRadius="10" Padding="8,6" Margin="0,2" Cursor="Hand"
                                                            Tag="{Binding}" MouseLeftButtonUp="Clip_Click" MouseRightButtonUp="Clip_RightClick">
                                                        <StackPanel>
                                                            <Image Source="{Binding Image}" MaxHeight="70" HorizontalAlignment="Left" Visibility="{Binding ImageVis}"/>
                                                            <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Fg}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Footer}" Style="{StaticResource Sub}" FontSize="10"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ===== SYSTÈME ===== -->
                        <Grid x:Name="PanelSystem" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <UniformGrid x:Name="StatsGrid" Columns="4" Rows="2"/>
                            <UniformGrid Grid.Row="1" Columns="3">
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Disques" Style="{StaticResource H}" Margin="0,0,0,4"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DiskList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Bluetooth" Style="{StaticResource H}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="BtEmpty" DockPanel.Dock="Top" Text="Aucun appareil connecté" Style="{StaticResource Sub}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="BtList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Téléchargements" Style="{StaticResource H}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="DlEmpty" DockPanel.Dock="Top" Text="Rien en cours" Style="{StaticResource Sub}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DlList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <!-- ===== INFOS ===== -->
                        <Grid x:Name="PanelInfo" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.25*"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="WeatherIcon" Text="☀" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="26" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="WeatherTemp" Text="--°" FontSize="30" FontWeight="Light" Foreground="{DynamicResource Fg}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="WeatherDesc" DockPanel.Dock="Top" Style="{StaticResource H}" FontSize="12"/>
                                        <TextBlock x:Name="WeatherCity" DockPanel.Dock="Top" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="WeatherDaily" ItemTemplate="{StaticResource InfoRowTpl}"/>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Horloges" Style="{StaticResource H}" Margin="0,0,0,2"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ClockList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Agenda" Style="{StaticResource H}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="CalEmpty" DockPanel.Dock="Top" Text="Ajoute l'URL ICS de ton agenda Google/Outlook dans les réglages." Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CalList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Marchés" Style="{StaticResource H}" Margin="0,0,0,2"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MarketList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock x:Name="SportTitle" DockPanel.Dock="Top" Text="Sport" Style="{StaticResource H}" Margin="0,0,0,2"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SportList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Amis Steam" Style="{StaticResource H}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="SteamEmpty" DockPanel.Dock="Top" Text="Ajoute ta clé API Steam et ton SteamID dans les réglages." Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SteamList" ItemTemplate="{StaticResource InfoRowTpl}"/></ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ===== LANCER ===== -->
                        <Grid x:Name="PanelLaunch" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Calcul, minuteurs &amp; applis" Style="{StaticResource H}"/>
                                    <TextBox x:Name="CalcInput" DockPanel.Dock="Top" Style="{StaticResource Input}" FontSize="14" Margin="0,8,0,0"
                                             ToolTip="Calcul, unité ou devise" KeyUp="CalcInput_KeyUp"/>
                                    <TextBlock x:Name="CalcResult" DockPanel.Dock="Top" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Fg}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" Margin="2,8,0,0" Cursor="Hand" ToolTip="Cliquer pour copier"
                                               TextTrimming="CharacterEllipsis" MouseLeftButtonUp="CalcResult_Click"/>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="2,2,0,6"
                                               Text="Ex. : 12*(3+4) · 10 mi en km · 100 USD en EUR · 15 min thé (minuteur) · nom d'une appli + Entrée"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="CalcHistory" ItemTemplate="{StaticResource InfoRowTpl}"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" AllowDrop="True" Drop="Shortcuts_Drop">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Raccourcis" Style="{StaticResource H}"/>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,6"
                                               Text="Glisse ici une appli, un fichier, un dossier ou un lien pour l'ajouter."/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="ShortcutHost"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Alimentation" Style="{StaticResource H}" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="PowerHost"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ===== PLUS (1.3) : contenu construit dans MainWindow.More.cs ===== -->
                        <ScrollViewer x:Name="PanelMore" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="MoreGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ScrollViewer>

                        <!-- ===== PLUGINS ===== -->
                        <Grid x:Name="PanelPlugins" Visibility="Collapsed">
                            <TextBlock x:Name="PluginEmpty" Style="{StaticResource Sub}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                                       Text="Aucun plugin. Dépose une DLL implémentant IIslandPlugin dans %AppData%\Malbo\plugins puis relance l'app."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="PluginHost"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
        </Border>

        <!-- Bulle : 2e activité (minuteur, vocal, téléchargement) -->
        <Border x:Name="Bubble" Width="0" Height="36" CornerRadius="18" Opacity="0" Margin="0,8,0,0"
                Background="{DynamicResource IslandBg}" VerticalAlignment="Top" ClipToBounds="True" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Grid Width="36" Height="36" HorizontalAlignment="Center">
                <Ellipse x:Name="BubbleTrack" Width="30" Height="30" Stroke="#33888888" StrokeThickness="2.5" Visibility="Hidden"/>
                <Ellipse x:Name="BubbleRing" Width="30" Height="30" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                         RenderTransformOrigin="0.5,0.5" Visibility="Hidden">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="BubbleGlyph" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Fg}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="BubbleText" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        </StackPanel>
    </Grid>
</Window>
