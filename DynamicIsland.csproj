<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Malbo</AssemblyName>
    <ApplicationIcon>Assets\malbo.ico</ApplicationIcon>
    <Product>Malbo</Product>
    <Version>1.1.0</Version>
    <RootNamespace>DynamicIsland</RootNamespace>
    <NoWarn>CA1416;CS4014;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\malbo.png" />
    <Resource Include="Assets\malbo.ico" />
  </ItemGroup>
</Project>
